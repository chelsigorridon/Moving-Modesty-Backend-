# Neon Postgres (use the pooled connection string for the deployed app)
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/neondb?sslmode=require

# Admin access
ADMIN_EMAIL=owner@movingmodesty.co.za
ADMIN_PASSWORD_HASH=salt:derived-key
AUTH_SECRET=replace-with-a-long-random-secret

# Resend
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Moving Modesty <orders@movingmodesty.co.za>
RESEND_PAYMENT_CONFIRMED_TEMPLATE=customer-payment-confirmed
RESEND_ADMIN_NEW_ORDER_TEMPLATE=admin-new-paid-order

# Public store address used in email links
STORE_URL=https://movingmodesty.co.za

# The single customer-facing Framer admin portal. Legacy Vercel dashboard pages redirect here.
FRAMER_ADMIN_URL=https://holistic-brand-492217.framer.app

# Optional JSON override for the server-validated checkout catalogue.
# Each item needs: sku, slug, name, colour, size, price, image.
CHECKOUT_CATALOGUE_JSON=

# Bob Go: enable Production only after sandbox sign-off and live configuration.
# Keep Preview disabled if it shares the live order database.
BOBGO_INTEGRATION_ENABLED=false
BOBGO_ENVIRONMENT=sandbox
BOBGO_API_TOKEN=
BOBGO_SENDER_NAME=Moving Modesty
BOBGO_SENDER_EMAIL=
BOBGO_SENDER_PHONE=
BOBGO_SENDER_LOCATION_NAME=Constantia Emporium
BOBGO_PICKUP_POINT_LOCATION_ID=
BOBGO_PICKUP_POINT_PROVIDER_SLUG=

# PayFast remains disabled until account verification is complete.
PAYFAST_INTEGRATION_ENABLED=false
PAYFAST_ENVIRONMENT=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Keep enabled for production. It verifies the callback IP against PayFast's hosts.
PAYFAST_SOURCE_IP_VALIDATION=true

# Added to the AdminPortal component's “Vercel API” property in Framer after deployment
# Example: https://moving-modesty-admin.vercel.app
