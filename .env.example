# Neon Postgres (use the pooled connection string for the deployed app)
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/neondb?sslmode=require

# Admin access
ADMIN_EMAIL=owner@movingmodesty.co.za
ADMIN_PASSWORD_HASH=salt:derived-key
AUTH_SECRET=replace-with-a-long-random-secret

# Resend
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Moving Modesty <orders@movingmodesty.co.za>
RESEND_PAYMENT_CONFIRMED_TEMPLATE=customer-payment-confirmed
RESEND_ADMIN_NEW_ORDER_TEMPLATE=admin-new-paid-order
RESEND_ORDER_CANCELLED_TEMPLATE=customer-order-cancelled
# Production-only technical alerts, separate from customer/owner notifications.
ERROR_ALERT_EMAIL=moody.tech@gmail.com
# Obtain from the Resend webhook details AFTER registering /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# Public store address used in email links
STORE_URL=https://movingmodesty.com

# The single customer-facing Framer admin portal. Legacy Vercel dashboard pages redirect here.
FRAMER_ADMIN_URL=https://holistic-brand-492217.framer.app

# Optional JSON override for the server-validated checkout catalogue.
# Each item needs: sku, slug, name, colour, size, price, image.
CHECKOUT_CATALOGUE_JSON=

# Bob Go manual booking: enable Production only after verified live configuration.
# Keep Preview disabled if it shares the live order database.
BOBGO_INTEGRATION_ENABLED=false
BOBGO_ENVIRONMENT=sandbox
BOBGO_API_TOKEN=
BOBGO_SENDER_NAME=Moving Modesty
BOBGO_SENDER_EMAIL=
BOBGO_SENDER_PHONE=
BOBGO_SENDER_LOCATION_NAME=Constantia Emporium
BOBGO_PICKUP_POINT_LOCATION_ID=
BOBGO_PICKUP_POINT_PROVIDER_SLUG=

# Prepared order-sync backend: remains HARD DISABLED in code, even with keys.
# Do not replace the existing manual-booking token. No NEXT_PUBLIC_ prefixes.
# Production activation only. Set one permanent ISO UTC cutoff before enabling;
# only orders originally created on/after it can sync or use linked booking.
# Sync never books a waybill automatically. Preview always remains disabled.
BOBGO_ORDER_SYNC_ENABLED=false
BOBGO_LINKED_BOOKING_ENABLED=false
BOBGO_NEW_ORDERS_FROM=
BOBGO_ORDER_SYNC_API_TOKEN=
BOBGO_ORDER_SYNC_CHANNEL_REF=
# At least 32 random characters, entered privately in Vercel. Never in a URL.
CRON_SECRET=

# PayFast remains disabled until account verification is complete.
PAYFAST_INTEGRATION_ENABLED=false
PAYFAST_ENVIRONMENT=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Keep enabled for production. It verifies the callback IP against PayFast's hosts.
PAYFAST_SOURCE_IP_VALIDATION=true

# Delivery tracking updates only; never enables sales-channel order copying or
# automatic bookings. Apply migration 0016 before enabling in Production.
BOBGO_DELIVERY_UPDATES_ENABLED=false
BOBGO_WEBHOOK_SECRET=

# Temporary, owner-only hybrid test. Never change normal PAYFAST_* settings.
# This starts disabled. Configure separate sandbox credentials, not live keys.
LIVE_COURIER_TEST_ENABLED=false
PAYFAST_TEST_MERCHANT_ID=
PAYFAST_TEST_MERCHANT_KEY=
PAYFAST_TEST_PASSPHRASE=
# Set a separate random 32+ character CRON_SECRET to protect the recovery runner
# at /api/internal/bobgo-delivery, then configure a recurring GET to that route.
# Do not regenerate Bob Go's existing webhook secret without updating its users.

# Added to the AdminPortal component's “Vercel API” property in Framer after deployment
# Example: https://moving-modesty-admin.vercel.app
## Optional extra browser origins, comma separated; never use a wildcard.
API_ALLOWED_ORIGINS=

# Draft-only product trial: enable only on a separate Preview database after
# applying migration 0008 there. Does not enable CMS publication or live stock.
PRODUCT_CATALOGUE_TRIAL_ENABLED=false
PRODUCT_MANAGEMENT_ENABLED=false

# Build/review first. Apply the discount migration to a separate preview database
# before enabling this; never creates or activates any codes automatically.
DISCOUNTS_ENABLED=false

# Read-only Framer connection proof. Local/Preview only; does not publish or sync.
# Keep the API key private and server-side. Never use a NEXT_PUBLIC_ prefix.
FRAMER_CATALOGUE_PROBE_ENABLED=false
FRAMER_PROJECT_URL=https://framer.com/projects/Moving-Modesty--HSoQpURWMbVB013b2Lkg-6iAuo
FRAMER_API_KEY=

# Local-only TEST draft name/description/tagline saving; never Production/Preview.
FRAMER_CATALOGUE_DRAFT_SAVE_ENABLED=false
